# NewMode Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-newmode --about` for the
# authoritative list.

# Required: OAuth client ID for the NewMode OAuth app
TAP_NEWMODE_CLIENT_ID=your_client_id_here

# Required: OAuth client secret for the NewMode OAuth app
TAP_NEWMODE_CLIENT_SECRET=your_client_secret_here

# Optional: OAuth refresh token (if your flow uses one)
TAP_NEWMODE_REFRESH_TOKEN=your_refresh_token_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_NEWMODE_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://base.newmode.net)
TAP_NEWMODE_API_URL=https://base.newmode.net
