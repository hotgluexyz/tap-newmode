# New/Mode Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-newmode --about` for the
# authoritative list.

# Required: New/Mode OAuth client id
TAP_NEWMODE_CLIENT_ID=your_client_id_here

# Required: New/Mode OAuth client secret
TAP_NEWMODE_CLIENT_SECRET=your_client_secret_here

# Optional: API base URL (defaults to https://base.newmode.net)
TAP_NEWMODE_API_BASE_URL=https://base.newmode.net

# Optional: The earliest record date to sync (ISO-8601)
TAP_NEWMODE_START_DATE=2000-01-01T00:00:00Z

# Optional: fetch tokens from the Hotglue access token endpoint instead of New/Mode
TAP_NEWMODE__REFRESH_TOKEN_VIA_HG_API=false
